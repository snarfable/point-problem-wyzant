{
    "version": 8,
    "configurePresets": [
        {
            "name": "production",
            "displayName": "Configure preset using Makefiles generator",
            "description": "Sets Unix Makefiles generator, build and install directory",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-production",
            "configurePreset": "production",
            "description": "Builds the project using the default configuration preset"
        }
    ]
}
